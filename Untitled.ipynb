


import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns



data=pd.read_csv(r"C:\Users\USer\Downloads\archive.zip")
data


data.isnull().sum()





from sklearn.preprocessing import LabelEncoder
le= LabelEncoder()
data["city"]=le.fit_transform(data["city"])


data


data.drop(["date","street","statezip"],axis=1,inplace=True)


data.duplicated()





from sklearn.preprocessing import StandardScaler


scaller= StandardScaler()
d=data[["sqft_living","sqft_lot","sqft_above","yr_built","yr_renovated","price_per_sqft"]]
data[["sqft_living","sqft_lot","sqft_above","yr_built","yr_renovated","price_per_sqft"]]=scaller.fit_transform(d)








x=data[["bedrooms","bathrooms","sqft_living","sqft_lot","floors","waterfront","view","condition","sqft_above","sqft_basement","yr_built","yr_renovated","city","price_per_sqft"]]
y=data["price"]





from sklearn.model_selection import train_test_split
x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.2)





from sklearn.ensemble import RandomForestRegressor
model=RandomForestRegressor()
model.fit(x_train,y_train)





model.score(x_train,y_train)*100


model.score(x_test,y_test)*100


model.predict([[3.0,1.50,1340,7912,1.5,0,0,3,1340,0,1955,2005,36,233.58]])



